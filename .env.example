# Copie para .env e preencha. Nunca commite o .env.
ANTHROPIC_API_KEY=
# Bot criado no @BotFather. O ID do chat aparece ao mandar /start para o bot com o worker rodando.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Token do GitHub sem nenhuma permissão extra (fine-grained, só leitura de repositórios públicos).
# Sem ele, a API limita a 60 requisições por hora.
GITHUB_TOKEN=
DATABASE_PATH=./data/radar.db

# Limites de custo da pontuação (claude-haiku-5-5)
SCAN_MAX_JOBS=50
DAILY_TOKEN_LIMIT=2000000

# Opcional: chave gratuita do Himalayas (himalayas.app/api) para um limite de requisições próprio.
HIMALAYAS_API_KEY=
