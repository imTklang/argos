# Copie para .env e preencha. Nunca commite o .env.
ANTHROPIC_API_KEY=
# Bot criado no @BotFather. O ID do chat aparece ao mandar /start para o bot com o worker rodando.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Token do GitHub sem nenhuma permissão extra (fine-grained, só leitura de repositórios públicos).
# Sem ele, a API limita a 60 requisições por hora.
GITHUB_TOKEN=
# Caminhos relativos partem da raiz do repositório.
DATABASE_PATH=./data/radar.db
# PREFERENCES_PATH=./data/preferences.json
# SOURCES_CONFIG_PATH=./config/sources.json

# Limites de custo da pontuação (claude-haiku-5-5)
SCAN_MAX_JOBS=50
DAILY_TOKEN_LIMIT=2000000

# Opcional: chave gratuita do Himalayas (himalayas.app/api) para um limite de requisições próprio.
HIMALAYAS_API_KEY=

# Fuso das varreduras (8h e 18h) e do limite diário de tokens.
ARGOS_TIMEZONE=America/Fortaleza

# Servidor (docs/deploy.md). Sem login: use só numa rede privada como o Tailscale.
# API_HOST=0.0.0.0
# Nomes aceitos além do localhost, separados por vírgula.
ALLOWED_HOSTS=

# Backup contínuo do banco com Litestream (docker compose --profile backup up -d)
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
