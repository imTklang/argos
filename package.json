{
  "name": "radar-estagio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @radar/db generate",
    "db:migrate": "pnpm --filter @radar/db migrate",
    "cli": "tsx --env-file-if-exists=.env apps/cli/src/index.ts",
    "worker": "tsx --env-file-if-exists=.env apps/api/src/worker.ts",
    "api": "tsx --env-file-if-exists=.env apps/api/src/serve.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
